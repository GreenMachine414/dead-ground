{
  "name": "zombie-survival",
  "productName": "Dead Ground",
  "version": "1.2.2",
  "description": "Top-down co-op zombie survival",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "start": "node build.js && node scripts/run.js",
    "dev": "node build.js && node scripts/run.js --dev",
    "test": "node build.js && node test/simtest.mjs && node test/bosstest.mjs && node test/featuretest.mjs && node test/coopstress.mjs",
    "smoke": "node build.js && node scripts/run.js --smoke",
    "perf": "node build.js && node scripts/run.js --perf",
    "trailer": "node build.js && node scripts/run.js --trailer",
    "finale": "node build.js && node scripts/run.js --finale",
    "stress": "node build.js && node test/coopstress.mjs",
    "crashtest": "node build.js && node scripts/run.js --crashtest",
    "stress:live": "node build.js && node scripts/stress.js",
    "dist": "node build.js && electron-builder --win portable nsis"
  },
  "build": {
    "appId": "com.deadground.game",
    "productName": "Dead Ground",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "electron/**",
      "dist/**",
      "!dist/**/*.map",
      "!dist/sim.mjs",
      "src/index.html",
      "src/style.css",
      "node_modules/ws/**",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  }
}
